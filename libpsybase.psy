== default ==
{
	add_build_file("./src/base.psy");
};

== test ==
{
	default();
	executable("test");
	debug_symbols(true);
};

int3 : asm("" -> v0)
{
	int3
};

my_assert : func(b : bool -> v0)
{
	if(!b)
	{
		int3();
	}
};

main : func(args : program_args mut? -> s32)
{
	putbytes("hello", 5);
	putchar('!');
	putsint(60);

	hello ::= zstr{.data := "hello";};
	goodbye ::= zstr{.data := "goodbye";};
	hello_there ::= zstr{.data := "hello there";};

	my_assert(zstrmatchz(hello, hello));
	my_assert(!zstrmatchz(hello, goodbye));
	my_assert(!zstrmatchz(hello, hello_there));

	my_assert(zstrbeginz(hello, hello));
	my_assert(!zstrbeginz(hello, goodbye));
	my_assert(!zstrbeginz(hello, hello_there));
	my_assert(zstrbeginz(hello_there, hello));

	testfile ::= file_open_or_create(zstr{.data := "./foo.txt";}, file_open_flag.read_write);
	putzstr("testfile: ");
	putzstr(enumname(testfile));
	putzstr("(");
	putsint(testfile@s64);
	putzstr(")");
	putchar(10);

	del ::= file_delete(zstr{.data := "./foo.txt";});
	putzstr("deletion yielded: ");
	putzstr(enumname(del));
	putzstr("(");
	putsint(del@s64);
	putzstr(")");
	putchar(10);

	sz ::= file_size(zstr{.data := "/usr/local/bin/psyc";});
	putzstr("size: ");
	putuint(sz);
	putzstr(" bytes");
	putchar(10);

	mapping ::= file_map(file_open(zstr{.data := "/bin/bash";}, file_open_flag.read_only), 0, 10, file_map_flag.read);
	putzstr("map yielded: ");
	putzstr(enumname(mapping.result));
	putzstr("(");
	putsint(mapping.result@s64);
	putzstr(")");
	putchar(10);

	file_unmap(mapping);
	
	return 0;
};
