zstr : struct
{
	data : u8 mut?;
};

zstrdata : func(z : zstr -> u8 mut?)
{
	return z.data;
};

zstrlen : func(z : zstr -> u64)
{
	ptr : u8? mut := zstrdata(z);
	i : u64 mut := 0;
	while([ptr] != 0)
	{
		ptr = ptr # 1;
		i = i + 1;
	}
	return i;
};

zstr2sstr : func(z : zstr -> sstr)
{
	return sstr{.data := zstrdata(z); .len := zstrlen(z);};
};

sstr : struct
{
	data : u8 mut?;
	len : u64;
};

sstrdata : func(s : sstr -> u8 mut?)
{
	return s.data;
};

sstrlen : func(s : sstr -> u64)
{
	return s.len;
};

sstr2zstr : func(s : sstr, ar : arena mut? -> zstr)
{
	slen ::= sstrlen(s);
	zdat : u8 mut? := arena_alloc(ar, slen + 1);
	memcopy(zdat, sstrdata(s), slen);
	[zdat # slen] = zero;
	return zstr{.data := zdat;};
};

// basic string operation

sstrmatchs : func(lhs : sstr, rhs : sstr -> bool)
{
	len ::= sstrlen(lhs);
	if(len != sstrlen(rhs))
	{
		return false;
	}
	return memeql(sstrdata(lhs), sstrdata(rhs), len);
};

zstrmatchz : func(lhs : zstr, rhs : zstr -> bool)
{
	return sstrmatchs(zstr2sstr(lhs), zstr2sstr(rhs));
};

sstrmatchsz : func(lhs : sstr, rhs : zstr -> bool)
{
	return sstrmatchs(lhs, zstr2sstr(rhs));
};

zstrmatchzs : func(lhs : zstr, rhs : sstr -> bool)
{
	return sstrmatchs(zstr2sstr(lhs), rhs);
};

sstrbegins : func(b : sstr, begin_with : sstr -> bool)
{
	blen ::= sstrlen(b);
	slen ::= sstrlen(begin_with);
	if(blen < slen)
	{
		return false;
	}
	return memeql(sstrdata(b), sstrdata(begin_with), slen);
};

zstrbegins : func(b : zstr, begin_with : sstr -> bool)
{
	return sstrbegins(zstr2sstr(b), begin_with);
};

sstrbeginz : func(b : sstr, begin_with : zstr -> bool)
{
	return sstrbegins(b, zstr2sstr(begin_with));
};

zstrbeginz : func(b : zstr, begin_with : zstr -> bool)
{
	return sstrbegins(zstr2sstr(b), zstr2sstr(begin_with));
};
