file : enum
{
	// msb 1 reserved for error types
	.cwd := 0x8000000000000000;
	.err_invalid_access_flags := 0x8000000000000001;
	.err_permission_denied := 0xfffffffffffffff3;
	.err_not_found := 0xfffffffffffffffe;
	.err_invalid_directory := 0xffffffffffffffec;
};

file_open_flag : enum
{
	// info/metadata only, i.e file_size
	.info_only := 0x0000000000000001;
	// read + map(read) is valid
	.read_only := 0x0000000000000002;
	// write + map(write) is valid
	.write_only := 0x0000000000000004;
	// read/write + map(read/write) is valid
	.read_write := 0x0000000000000008;
};

// return true if the filename exists. otherwise false
// if filename is an absolute path, relative_to is ignored
// otherwise, if relative_to is file.cwd, then filename is relative to the current working directory
// otherwise, filename is relative to the provided file
filename_exists : func(filename : zstr, relative_to : file -> bool)
{
	linux_rel_flags : s32 mut := relative_to@s64 weak;
	if(relative_to == file.cwd)
	{
		linux_rel_flags = AT_FDCWD;
	}
	return syscall3(syscall.faccessat, linux_rel_flags, zstrdata(filename)@u64, zero) == 0;
};

// get the size, in bytes, of a named file
// if filename is an absolute path, relative_to is ignored
// otherwise, if relative_to is file.cwd, then filename is relative to the current working directory
// otherwise, filename is relative to the provided file
// if the file ultimately isnt found, 0 is returned
filename_size : func(filename : zstr, relative_to : file -> u64)
{
	linux_rel_flags : s32 mut := relative_to@s64 weak;
	if(relative_to == file.cwd)
	{
		linux_rel_flags = AT_FDCWD;
	}
	statbuf : stat_t mut;
	if(syscall4(syscall.newfstatat, linux_rel_flags, zstrdata(filename)@u64, ref statbuf@u64, zero) != 0)
	{
		return 0;
	}
	return statbuf.st_size@_;
};

// open a file on the assumption that it exists
// if filename is an absolute path, relative_to is ignored
// otherwise, if relative_to is file.cwd, then filename is relative to the current working directory
// otherwise, filename is relative to the provided file
file_open : func(filename : zstr, flags : file_open_flag, relative_to : file -> file)
{
	linux_open_flags : s32 := _file_open_flag2linux(flags);
	linux_rel_flags : s32 mut := relative_to@s64 weak;
	if(relative_to == file.cwd)
	{
		linux_rel_flags = AT_FDCWD;
	}

	// flags must contain *exactly* one of the following flags
	required_access_flags ::= file_open_flag.read_only | file_open_flag.write_only | file_open_flag.read_write | file_open_flag.info_only;
	if(x86_64_popcnt(required_access_flags & flags) != 1)
	{
		return file.err_invalid_access_flags;
	}
	return syscall4(syscall.openat, linux_rel_flags, zstrdata(filename)@u64, linux_open_flags, _linux_default_open_mode);
};

// open a file, but if the file doesn't exist, attempt to create it.
// if filename is an absolute path, relative_to is ignored
// otherwise, if relative_to is file.cwd, then filename is relative to the current working directory
// otherwise, filename is relative to the provided file
file_open_or_create : func(filename : zstr, flags : file_open_flag, relative_to : file -> file)
{
	// identical to file_open except that O_CREAT is also passed
	linux_open_flags : s32 := _file_open_flag2linux(flags) | O_CREAT;
	linux_rel_flags : s32 mut := relative_to@s64 weak;
	if(relative_to == file.cwd)
	{
		linux_rel_flags = AT_FDCWD;
	}

	// flags must contain *exactly* one of the following flags
	required_access_flags ::= file_open_flag.read_only | file_open_flag.write_only | file_open_flag.read_write;
	if(x86_64_popcnt(required_access_flags & flags) != 1)
	{
		return file.err_invalid_access_flags;
	}
	return syscall4(syscall.openat, linux_rel_flags, zstrdata(filename)@u64, linux_open_flags, _linux_default_open_mode);
};

// get, in bytes, the current size of the file
file_size : func(f : file -> u64)
{
	statbuf : stat_t mut;
	if(syscall2(syscall.fstat, f, ref statbuf@u64) != 0)
	{
		return 0;
	}
	return statbuf.st_size@_;
};

file_map_flag : enum
{
	// the region exist but you can't really do anything on it
	.none := zero;
	// you can read to the mapped region
	.read := 1;
	// you can write to the mapped region
	.write := 2;
	// you can execute the mapped region
	.execute := 4;
};

file_mapping_result : enum
{
	.success := 0;
	.err_unknown := 0x8000000000000001;
	.err_permission_denied := 0xfffffffffffffff3;
	.err_bad_file := 0xfffffffffffffff7;
};

// represents a mapped file
file_mapping : struct
{
	ptr : v0? weak;
	len : u64;
	result : file_mapping_result;
};

// attempt to map a files contents to memory
// offset is the number of bytes from the start of the file's contents to map
// len is the number of bytes that comprises the mapped region.
// offset and len must constitute a valid region of file contents that dont lie outside of the file size limits
file_map : func(f : file, offset : u64, len : u64, flags : file_map_flag -> file_mapping)
{
	prot ::= _file_map_flag2linux(flags);
	//MAP_PRIVATE ::= 0x02;
	retval : s64 := syscall6(syscall.mmap, zero, len, prot, MAP_PRIVATE, f, offset);
	if(retval < 0)
	{
		// negative. is not an address but an error code.
		return file_mapping
		{
			.ptr := zero;
			.result := retval@file_mapping_result;
		};
	}
	return file_mapping
	{
		.ptr := retval@u64@v0?;
		.len := len;
		.result := file_mapping_result.success;
	};
};

// free a previous mapping retrieved fom file_map
file_unmap : func(mapping : file_mapping -> v0)
{
	if(mapping.ptr == zero)
	{
		return;
	}
	syscall2(syscall.munmap, mapping.ptr@u64, mapping.len);
};

// read file contents into an existing buffer
// offset is the number of bytes from the start of the file's contents to read
// len is the number of bytes to read from offset, and the minimum size of the buffer
// offset and len must constitute a valid region of file contents that dont lie outside of the file size limits
file_read : func(f : file, offset : u64, len : u64, buffer : u8 mut? -> u64)
{
	ret ::= syscall4(syscall.pread64, f, buffer@u64, len, offset);
	if(ret < 0)
	{
		// just swallow all errors and return 0
		return 0;
	}
	return ret;
};

// write some data to a file
// offset is the number of bytes from the start of the file's contents to write
// len is the number of bytes to write from offset, and the minimum size of the buffer
// offset and len must constitute a valid region of file contents that dont lie outside of the file size limits
// any data that already lies at the given offset will be overwritten.
file_write : func(f : file, offset : u64, len : u64, buffer : u8? -> u64)
{
	ret ::= syscall4(syscall.pwrite64, f, buffer@u64, len, offset);
	if(ret < 0)
	{
		return 0;
	}
	return ret;
};

// resize a file
// if the size is an increase, zero bytes are appended to the end
// if the size is a decrease, the contents previously at the end of the old capacity is discarded
// if the file was previously mapped, accessing discarded contents as a result of a decrease, in any way,becomes hazardous. accessing any newly-formed zero bytes in the case of an increase is also hazardous.
// in general, resizing a file while you hold a mapping to it is error-prone.
file_resize : func(f : file, size : u64 -> v0)
{
	syscall2(syscall.ftruncate, f, size);
};

// close a file.
file_close : func(f : file -> v0)
{
	syscall1(syscall.close, f);
};

file_delete_result : enum
{
	.success := 0;
	.err_unknown := 0x8000000000000001;
	.err_permission_denied := 0xfffffffffffffff3;
	.err_not_found := 0xfffffffffffffffe;
};

// delete a file by name
// if filename is an absolute path, relative_to is ignored
// otherwise, if relative_to is file.cwd, then filename is relative to the current working directory
// otherwise, filename is relative to the provided file
file_delete : func(filename : zstr, relative_to : file -> file_delete_result)
{
	linux_rel_flags : s32 mut := relative_to@s64 weak;
	if(relative_to == file.cwd)
	{
		linux_rel_flags = AT_FDCWD;
	}
	ret ::= syscall3(syscall.unlinkat, linux_rel_flags, zstrdata(filename)@u64, zero)@s64@file_delete_result;
	if(zstrmatchz(zstr{.data := enumname(ret);}, zstr{.data := "badenum";}))
	{
		return file_delete_result.err_unknown;
	}
	return ret;
};

// implementation details

x86_64_popcnt : asm("={rax},{rdi}" -> u64 weak)
{
	popcnt rax, rdi
};
_linux_default_open_mode ::= 0x1ff; // 0777 octal

O_RDONLY ::= 0x0;
O_WRONLY ::= 0x1;
O_RDWR   ::= 0x2;

O_APPEND ::= 0x400;
O_ASYNC  ::= 0x2000;
O_CLOEXEC ::= 0x80000;
O_CREAT ::= 0x40;
O_DIRECT ::= 0x4000;
O_DIRECTORY ::= 0x10000;
O_DSYNC ::= 0x1000;
O_EXCL ::= 0x80;
O_LARGEFILE ::= 0x0;
O_NOATIME ::= 0x40000;
O_NOCTTY ::= 0x100;
O_NOFOLLOW ::= 0x20000;
O_NONBLOCK ::= 0x800;
O_NDELAY ::= 0x800;
O_PATH ::= 0x200000;
O_NSYNC ::= 0x101000;
O_TMPFILE ::= 0x410000;
O_TRUNC ::= 0x200;
AT_FDCWD ::= 0xffffffffffffff9C;
AT_REMOVEDIR ::= 0x200;

_file_open_flag2linux : func(flags : file_open_flag -> s32)
{
	ret : s32 mut := 0;
	// O_RDONLY
	if((flags & file_open_flag.read_only)@s64 > 0)
	{
		ret = ret | O_RDONLY;
	}
	// O_WRONLY
	if((flags & file_open_flag.write_only)@s64 > 0)
	{
		ret = ret | O_WRONLY;
	}
	// O_RDWR
	if((flags & file_open_flag.read_write)@s64 > 0)
	{
		ret = ret | O_RDWR;
	}

	// O_APPEND
	// O_ASYNC
	// O_CLOEXEC
	// O_CREAT
	// O_DIRECT
	// O_DIRECTORY
	// O_DSYNC
	// O_EXCL
	// O_LARGEFILE
	// O_NOATIME
	// O_NOCTTY
	// O_NOFOLLOW
	// O_NONBLOCK or O_NDELAY
	// O_PATH
	if((flags & file_open_flag.info_only)@s64 > 0)
	{
		ret = ret | O_PATH;
	}
	// O_SYNC
	// O_TMPFILE
	// O_TRUNC
	return ret;
};

_file_map_flag2linux : func(flags : file_map_flag -> s32)
{
	ret : s32 mut := PROT_NONE;
	if((flags & file_map_flag.read)@s64 != 0)
	{
		ret = ret | PROT_READ;
	}
	if((flags & file_map_flag.write)@s64 != 0)
	{
		ret = ret | PROT_WRITE;
	}
	if((flags & file_map_flag.execute)@s64 != 0)
	{
		ret = ret | PROT_EXEC;
	}
	return ret;
};

timespec : struct
{
	tv_sec : u64;
	tv_nsec : u64;
};

stat_t : struct
{
	st_dev : u64;
	st_ino : u64;
	st_mode : u32;
	mypad : u32;
	st_nlink : u64;
	st_uid : u32;
	st_gid : u32;
	st_rdev : u64;

	st_size : s64;
	st_blksize : s64;
	st_blocks : s64;

	st_atim : timespec;
	pad0 : u32;
	st_mtim : timespec;
	pad1 : u32;
	st_ctim : timespec;
	pad2 : u32;

	pad3 : u64;
	pad4 : u64;
};

dirent : struct
{
	d_ino : u64;
	d_off : s64;
	d_reclen : u16;
	d_name : u8[256];
};

DIR : struct
{
	tell : u64;
	fd : s32;
	buf_pos : s32;
	buf_end : s32;
	lock : s32[1];
	buf : u8[2048];
};
